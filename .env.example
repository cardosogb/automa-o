# ==== Origem: Titan (IMAP básico) ====
TITAN_HOST=imap.titan.email
TITAN_PORT=993

# ==== Destino: Microsoft 365 (IMAP + OAuth2 app-only) ====
M365_HOST=outlook.office365.com
M365_PORT=993

# Credenciais do App Registration no Microsoft Entra ID (Azure AD).
# Veja o README (seção "Configurar o OAuth2 no Azure") para gerar estes valores.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ==== Caminhos / comportamento ====
ACCOUNTS_CSV=accounts.csv
BACKUP_DIR=backups
# Pausa em segundos entre uploads (evita throttling do M365).
UPLOAD_THROTTLE=0.1
MAX_RETRIES=4
